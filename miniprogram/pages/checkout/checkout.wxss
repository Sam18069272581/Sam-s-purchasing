.addr { position: relative; padding-right: 60rpx; }
.addr-top { margin-bottom: 8rpx; }
.b { font-weight: 600; font-size: 30rpx; }
.ml { margin-left: 20rpx; }
.addr-empty { color: #0b4ea2; font-size: 30rpx; padding: 10rpx 0; }
.arrow { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); color: #b8bec7; font-size: 40rpx; }
.it { display: flex; align-items: center; padding: 12rpx 0; }
.it-name { flex: 1; }
.it-sub { width: 150rpx; text-align: right; }
.line { display: flex; justify-content: space-between; padding: 8rpx 0; }
.total { border-top: 2rpx solid #eef0f3; margin-top: 12rpx; padding-top: 18rpx; font-weight: 600; }
.remark { width: 100%; min-height: 80rpx; font-size: 26rpx; }
.tip { padding: 0 30rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; display: flex; align-items: center; padding: 16rpx 24rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.05); }
.sum { flex: 1; }
.big { font-size: 36rpx; }
.pay { width: 240rpx !important; margin: 0 !important; height: 80rpx; line-height: 80rpx; padding: 0 !important; }
