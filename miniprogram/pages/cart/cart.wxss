.empty-art { width: 200rpx; height: 200rpx; margin: 0 auto 40rpx; border-radius: 50%; background: #fff; box-shadow: var(--shadow); display: flex; align-items: center; justify-content: center; }
.empty-art image { width: 96rpx; height: 96rpx; opacity: .5; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--ink); margin-bottom: 12rpx; }
.empty .go { width: 320rpx !important; margin-top: 56rpx; }
.toolbar { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 36rpx 4rpx; }
.count { font-size: 26rpx; color: var(--sub); }
.link { color: var(--ink); font-size: 26rpx; }
.list { margin: 16rpx 28rpx 0; }
.item { display: flex; align-items: center; background: #fff; border-radius: var(--radius); padding: 28rpx 28rpx 28rpx 20rpx; margin-bottom: 20rpx; box-shadow: var(--shadow); max-height: 400rpx; overflow: hidden; transition: all .3s ease; }
.item.removing { opacity: 0; transform: translateX(-60rpx); max-height: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; }
.check { width: 40rpx; height: 40rpx; border-radius: 50%; border: 3rpx solid #D3D0C8; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .2s ease; box-sizing: border-box; }
.check .tick { width: 10rpx; height: 18rpx; border: solid #fff; border-width: 0 4rpx 4rpx 0; transform: rotate(45deg) scale(0); margin-top: -4rpx; transition: transform .2s cubic-bezier(.3, 1.6, .6, 1); }
.check.on { background: var(--ink); border-color: var(--ink); }
.check.on .tick { transform: rotate(45deg) scale(1); }
.img { width: 152rpx; height: 152rpx; border-radius: 22rpx; margin: 0 22rpx; flex-shrink: 0; }
.info { flex: 1; min-width: 0; }
.name { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }
.summary { margin-top: 8rpx; }
.line { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 28rpx; }
.muted-28 { color: var(--sub); }
.free { margin-top: 12rpx; font-size: 24rpx; color: #8A6A3B; background: var(--gold-soft); padding: 12rpx 20rpx; border-radius: 12rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, .96); display: flex; align-items: center; padding: 20rpx 28rpx; box-shadow: 0 -8rpx 32rpx rgba(20, 33, 61, .06); }
.all { display: flex; align-items: center; font-size: 26rpx; color: var(--sub); }
.all .check { margin-right: 12rpx; }
.sum { flex: 1; display: flex; align-items: baseline; justify-content: flex-end; margin-right: 24rpx; }
.sum-label { font-size: 24rpx; color: var(--sub); margin-right: 8rpx; }
.pay { width: 230rpx !important; margin: 0 !important; padding: 0 !important; height: 88rpx; line-height: 88rpx; }
