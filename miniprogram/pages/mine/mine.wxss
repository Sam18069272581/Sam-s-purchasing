.top { position: absolute; left: 0; right: 0; top: 0; height: 220rpx; background: var(--ink); border-radius: 0 0 48rpx 48rpx; }
.member { position: relative; margin: 24rpx 28rpx 0; border-radius: 32rpx; padding: 40rpx 36rpx 32rpx; color: #fff; overflow: hidden;
  background: linear-gradient(135deg, #2A3A5E 0%, #14213D 55%, #0E1830 100%); box-shadow: 0 24rpx 56rpx rgba(20, 33, 61, .35); border: 2rpx solid rgba(210, 176, 122, .35); }
.shine { position: absolute; top: -120rpx; right: -80rpx; width: 360rpx; height: 360rpx; border-radius: 50%; background: radial-gradient(circle, rgba(210, 176, 122, .35), rgba(210, 176, 122, 0) 70%); }
.member-row { display: flex; align-items: center; position: relative; z-index: 1; }
.avatar-btn { width: 120rpx !important; height: 120rpx; padding: 0 !important; margin: 0 !important; border-radius: 50%; background: transparent !important; border: 4rpx solid rgba(210, 176, 122, .8); }
.avatar-btn::after { border: none; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; }
.member-info { margin-left: 28rpx; flex: 1; }
.nick { font-size: 36rpx; font-weight: 700; color: #fff; }
.nick-ph { color: rgba(255, 255, 255, .5); }
.tag { display: inline-block; margin-top: 12rpx; padding: 4rpx 18rpx; border-radius: 20rpx; font-size: 22rpx; color: #14213D; background: linear-gradient(135deg, #E3C894, #B8935A); font-weight: 600; }
.member-foot { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 40rpx; padding-top: 28rpx; border-top: 2rpx solid rgba(255, 255, 255, .1); }
.member-foot > view:not(.sep) { flex: 1; text-align: center; }
.member-foot .k { font-size: 32rpx; font-weight: 700; color: #E3C894; }
.member-foot .v { font-size: 22rpx; color: rgba(255, 255, 255, .55); margin-top: 6rpx; }
.sep { width: 2rpx; height: 56rpx; background: rgba(255, 255, 255, .12); }

.login { margin: 40rpx 28rpx 0; }
.agree { display: flex; align-items: center; justify-content: center; margin-top: 28rpx; font-size: 22rpx; color: var(--sub); }
.agree .check { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.shake { animation: shake .4s ease; }
@keyframes shake { 0%, 100% { transform: none; } 20%, 60% { transform: translateX(-12rpx); } 40%, 80% { transform: translateX(12rpx); } }
.check { border-radius: 50%; border: 3rpx solid #D3D0C8; display: flex; align-items: center; justify-content: center; box-sizing: border-box; transition: all .2s ease; }
.check .tick { width: 8rpx; height: 14rpx; border: solid #fff; border-width: 0 3rpx 3rpx 0; transform: rotate(45deg) scale(0); margin-top: -4rpx; transition: transform .2s cubic-bezier(.3, 1.6, .6, 1); }
.check.on { background: var(--ink); border-color: var(--ink); }
.check.on .tick { transform: rotate(45deg) scale(1); }

.menu { margin: 40rpx 28rpx 0; background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 32rpx; font-size: 28rpx; text-align: left; position: relative; transition: background .2s ease; }
.menu-item + .menu-item::before { content: ""; position: absolute; left: 120rpx; right: 32rpx; top: 0; height: 2rpx; background: var(--line); }
.hover { background: #FAF8F4; }
.ic { width: 64rpx; height: 64rpx; border-radius: 20rpx; background: var(--gold-soft); display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.ic image { width: 36rpx; height: 36rpx; }
.mi-main { flex: 1; min-width: 0; }
.mi-title { font-weight: 600; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 4rpx; }
.arrow { color: #C3C6CC; font-size: 40rpx; margin-left: 12rpx; }
.contact { background: #fff !important; margin: 0 !important; padding: 32rpx !important; line-height: normal; width: 100% !important; font-weight: normal; border-radius: 0; font-size: 28rpx !important; color: var(--text) !important; }
.contact::after { border: none; }
.logout { text-align: center; color: var(--sub); margin: 48rpx; font-size: 26rpx; }
