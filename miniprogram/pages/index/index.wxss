page { height: 100%; overflow: hidden; }
.header { flex-shrink: 0; position: relative; z-index: 2; background: var(--bg); }
.nav { display: flex; align-items: center; padding-left: 36rpx; }
.brand { font-size: 34rpx; font-weight: 700; color: var(--ink); letter-spacing: 2rpx; }
.hero { padding: 8rpx 36rpx 0; }
.hero-title { font-size: 46rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.hero-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--sub); display: flex; align-items: center; }
.hero-sub .dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--gold); margin-right: 12rpx; }
.search { margin: 28rpx 28rpx 20rpx; height: 80rpx; border-radius: 40rpx; background: #fff; display: flex; align-items: center; padding: 0 32rpx; box-shadow: var(--shadow); }
.search-icon { width: 32rpx; height: 32rpx; margin-right: 16rpx; flex-shrink: 0; }
.search-input { flex: 1; font-size: 28rpx; }
.ph-text { color: #B4B7BE; }

.wrap { display: flex; flex-direction: column; height: 100vh; }
.body { flex: 1; min-height: 0; display: flex; }
.side { width: 176rpx; height: 100%; }
.side-item { position: relative; padding: 30rpx 0; text-align: center; font-size: 26rpx; color: var(--sub); transition: color .25s ease, font-size .25s ease; }
.side-item .bar { position: absolute; left: 0; top: 50%; width: 8rpx; height: 36rpx; margin-top: -18rpx; border-radius: 0 8rpx 8rpx 0; background: var(--gold); transform: scaleY(0); transition: transform .3s cubic-bezier(.2, .8, .2, 1); }
.side-item.on { color: var(--ink); font-weight: 700; font-size: 28rpx; }
.side-item.on .bar { transform: scaleY(1); }
.main { flex: 1; height: 100%; background: #fff; border-radius: 36rpx 0 0 0; box-shadow: -8rpx 0 40rpx rgba(20, 33, 61, .04); }
.group-title { padding: 32rpx 28rpx 8rpx; font-size: 24rpx; color: var(--sub); letter-spacing: 2rpx; }
.goods { display: flex; padding: 20rpx 28rpx; }
.goods-img { width: 176rpx; height: 176rpx; border-radius: 24rpx; flex-shrink: 0; background: #F0EEE9; }
.goods-info { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; min-width: 0; }
.goods-name { font-size: 29rpx; font-weight: 600; line-height: 1.35; color: var(--text); }
.spec { align-self: flex-start; margin-top: 10rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: var(--gold-soft); color: #8A6A3B; font-size: 21rpx; }
.goods-bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: center; }

.cart-bar { position: fixed; left: 28rpx; right: 28rpx; bottom: 24rpx; height: 112rpx; border-radius: 56rpx; background: rgba(20, 33, 61, .96); display: flex; align-items: center; padding: 0 12rpx 0 24rpx; z-index: 10; box-shadow: 0 20rpx 48rpx rgba(20, 33, 61, .35); transform: translateY(180%); transition: transform .45s cubic-bezier(.2, .9, .3, 1.15); }
.cart-bar.show { transform: none; }
.cart-icon { position: relative; width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; margin-top: -36rpx; box-shadow: 0 10rpx 24rpx rgba(184, 147, 90, .5); }
.cart-img { width: 44rpx; height: 44rpx; }
.cart-count { position: absolute; top: -6rpx; right: -6rpx; min-width: 36rpx; height: 36rpx; line-height: 36rpx; padding: 0 8rpx; border-radius: 18rpx; background: #E5484D; color: #fff; font-size: 20rpx; text-align: center; box-sizing: border-box; border: 3rpx solid #14213D; }
.cart-mid { flex: 1; margin-left: 22rpx; }
.cart-total { color: #fff; font-size: 36rpx; font-weight: 700; }
.cart-total .yen { font-size: 24rpx; margin-right: 2rpx; } .cart-total .dec { font-size: 24rpx; }
.cart-tip { color: rgba(255, 255, 255, .55); font-size: 20rpx; margin-top: 4rpx; }
.cart-go { height: 88rpx; line-height: 88rpx; padding: 0 44rpx; border-radius: 44rpx; background: linear-gradient(135deg, #D2B07A, #B8935A); color: #14213D; font-weight: 700; font-size: 28rpx; }

.ball-x { position: fixed; z-index: 99; width: 20px; height: 20px; transition: transform .55s linear; pointer-events: none; }
.ball-y { width: 20px; height: 20px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px rgba(184, 147, 90, .25); transition: transform .55s cubic-bezier(.5, -0.7, .85, .4); }
