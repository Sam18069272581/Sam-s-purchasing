<view class="card">
  <view class="field" bindtap="chooseLocation">
    <text class="label">所在位置</text>
    <view class="val {{region ? '' : 'ph'}}">{{region || '点击授权位置并在地图上选点'}}</view>
    <text class="loc">📍</text>
  </view>
  <view class="field">
    <text class="label">详细地址</text>
    <input class="val" placeholder="村/组/门牌号，或附近标志物" value="{{detail}}" data-k="detail" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="label">收货人</text>
    <input class="val" placeholder="姓名" value="{{name}}" data-k="name" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="label">手机号</text>
    <input class="val" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" data-k="phone" bindinput="onInput" />
  </view>
</view>
<view class="muted tip">山区地址建议写上附近的标志物（小卖部、村委会等），方便配送员找到。</view>
<view class="save"><button class="btn-primary" bindtap="onSave">保存</button></view>
