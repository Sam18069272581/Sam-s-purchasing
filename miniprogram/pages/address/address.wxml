<view class="map-card enter" bindtap="chooseLocation">
  <view class="map-bg"><view class="grid"></view><view class="pin-dot {{latitude ? 'set' : ''}}"></view></view>
  <view class="map-info">
    <view class="map-title">{{region ? '已选位置' : '选择收货位置'}}</view>
    <view class="map-text">{{region || '授权位置后在地图上选点，用于配送'}}</view>
  </view>
  <view class="map-btn">{{region ? '重新选择' : '去选择'}}</view>
</view>

<view class="form enter" style="animation-delay: 80ms">
  <view class="field">
    <view class="label">详细地址</view>
    <input class="val" placeholder="村 / 组 / 门牌号，或附近标志物" placeholder-class="ph-text" value="{{detail}}" data-k="detail" bindinput="onInput" />
  </view>
  <view class="field">
    <view class="label">收货人</view>
    <input class="val" placeholder="姓名" placeholder-class="ph-text" value="{{name}}" data-k="name" bindinput="onInput" />
  </view>
  <view class="field">
    <view class="label">手机号</view>
    <input class="val num" type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="ph-text" value="{{phone}}" data-k="phone" bindinput="onInput" />
  </view>
</view>
<view class="tip enter" style="animation-delay: 140ms">山区地址建议写上附近的标志物，比如小卖部、村委会，方便配送员找到。</view>
<view class="save enter" style="animation-delay: 200ms"><button class="btn-primary" bindtap="onSave">保存地址</button></view>
