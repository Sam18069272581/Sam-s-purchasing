{
  "name": "sams-daigou-miniprogram",
  "private": true,
  "description": "山姆代购小程序的自动化测试（单元 / 页面集成 / 端到端）",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 \"test/e2e/**/*.test.js\""
  },
  "devDependencies": {
    "htmlparser2": "^10.0.0",
    "morphdom": "^2.7.8",
    "playwright": "1.63.0"
  }
}
